# Gmail Configuration for Order Confirmation Emails
# Get Gmail App Password from: https://support.google.com/accounts/answer/185833

# Gmail sender email address
GMAIL_USER=orders@giovanni-official.com

# Gmail App Password (16 characters, no spaces)
# Example: abcd efgh ijkl mnop → abcdefghijklmnop
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Optional: Firebase Project ID (for local emulator)
FIREBASE_PROJECT_ID=giovanni-official
